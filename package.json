{
  "name": "ops-live-board",
  "private": true,
  "version": "0.1.0",
  "description": "KNAPP/Zebra prototype - real-time picking station operations board",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
